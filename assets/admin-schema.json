        "text"
      ],
      [
        "enabled",
        "Activo",
        "boolean"
      ]
    ]
  },
  "topics": {
    "label": "Temas",
    "help": "La primera coincidencia determina el tema. Los términos admiten raíces de palabras y se separan por punto y coma. Se ignoran mayúsculas y acentos.",
    "fields": [
      [
        "name",
        "Tema",
        "text"
      ],
      [
        "terms",
        "Términos o raíces",
        "list"
      ],
      [
        "enabled",
        "Activo",
        "boolean"
      ]
    ]
  },
  "segments": {
    "label": "Segmentos",
    "help": "Una noticia puede pertenecer a varios segmentos. Sin coincidencia se mantiene sin segmento; no se atribuye por el nombre del banco.",
