  "signals": {
    "label": "Novedades y lanzamientos",
    "help": "Se exige señal y contexto de producto. headline busca la señal solo en el titular; fullText incluye el extracto. Las exclusiones siempre se aplican al titular. Listas separadas por punto y coma.",
    "fields": [
      [
        "name",
        "Novedad",
        "text"
      ],
      [
        "terms",
        "Términos de señal",
        "list"
      ],
      [
        "context",
