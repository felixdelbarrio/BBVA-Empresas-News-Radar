        "list"
      ],
      [
        "exclude",
        "Excluir si el titular contiene",
        "list"
      ],
      [
        "scope",
        "Ubicación de la señal: headline o fullText",
        "text"
      ],
      [
        "enabled",
        "Activa",
        "boolean"
      ]
    ]
  },
  "settings": {
