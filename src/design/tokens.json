{
  "css": {
    "color-primary-bg-main": "#001391",
    "color-primary-bg-action": "#001391",
    "color-primary-bg-action-pressed": "#070e46",
    "color-primary-bg-alternative": "#ffffff",
    "color-primary-bg-surface": "#f7f8f8",
    "color-primary-text-main": "#070e46",
    "color-primary-text-secondary": "#46536d",
    "color-primary-text-on-main": "#ffffff",
    "color-primary-border": "#cad1d8",
    "color-primary-accent-01": "#85c8ff",
