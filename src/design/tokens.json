    "color-primary-ui-system-focus": "#0c6dff",
    "space-1": "8px",
    "space-2": "16px",
    "space-3": "24px",
    "space-4": "32px",
    "space-5": "40px",
    "space-6": "48px",
    "space-8": "64px",
    "radius-container": "16px",
    "radius-component": "8px",
    "font-body": "'BBVA Benton Sans', Arial, sans-serif",
    "font-heading": "'Tiempos Headline', Georgia, serif",
    "text-s": "12px",
    "line-s": "16px",
    "text-m": "15px",
    "line-m": "24px",
    "text-l": "20px",
    "line-l": "24px",
    "text-xl": "24px",
    "line-xl": "32px",
    "text-2xl": "32px",
    "line-2xl": "40px",
    "text-3xl": "40px",
    "line-3xl": "48px",
    "sidebar-width": "288px",
    "content-width": "1296px",
    "control-height": "48px",
    "stroke": "1px",
    "focus-width": "2px",
    "focus-offset": "4px",
    "heat-0": "var(--color-primary-border)",
    "heat-1": "color-mix(in srgb, var(--color-primary-bg-action) 18%, var(--color-primary-bg-alternative))",
    "heat-2": "color-mix(in srgb, var(--color-primary-bg-action) 42%, var(--color-primary-bg-alternative))",
    "heat-3": "color-mix(in srgb, var(--color-primary-bg-action) 72%, var(--color-primary-bg-alternative))",
    "heat-4": "var(--color-primary-bg-action)",
    "chart-series-1": "var(--color-primary-bg-action)",
    "chart-series-2": "var(--color-primary-ui-system-focus)",
    "chart-series-3": "var(--color-primary-text-secondary)",
    "chart-series-4": "var(--color-primary-accent-01)",
    "chart-series-5": "var(--color-primary-accent-02)",
    "chart-series-6": "var(--color-primary-bg-action-pressed)",
    "shadow-panel": "0 12px 40px color-mix(in srgb, var(--color-primary-bg-action-pressed) 5%, transparent)",
    "shadow-focus": "0 0 0 4px color-mix(in srgb, var(--color-primary-accent-01) 30%, transparent)",
    "chart-stroke": "3px",
    "navigation-height": "80px",
    "mobile-navigation-height": "72px",
    "dialog-width": "560px"
  },
  "fonts": [
    {
      "file": "BentonSansBBVA-Book.woff2",
      "family": "BBVA Benton Sans",
      "weight": 400
    },
    {
      "file": "BentonSansBBVA-Medium.woff2",
      "family": "BBVA Benton Sans",
      "weight": 500
    },
    {
      "file": "tiempos-headline-bold.woff2",
      "family": "Tiempos Headline",
      "weight": 700
    }
  ],
  "sheet": {
    "background": "color-primary-bg-action-pressed",
    "foreground": "color-primary-text-on-main"
  }
}
